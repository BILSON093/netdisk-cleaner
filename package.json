{
  "name": "baidu-pan-cleaner",
  "version": "1.0.0",
  "description": "Free & open-source Baidu Netdisk cleaner: detect harmonized (blocked) files, find duplicates, batch cleanup",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node src/main.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable",
    "build": "pkg . --targets node18-win-x64 --output dist/baidu-pan-cleaner.exe --no-bytecode"
  },
  "keywords": [
    "baidu",
    "netdisk",
    "pan",
    "duplicate-finder",
    "cleaner"
  ],
  "author": "BILSON093",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.7",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.4",
    "puppeteer-core": "^25.14.0",
    "socks-proxy-agent": "^8.0.2"
  },
  "bin": "src/main.js",
  "pkg": {
    "assets": [
      "src/public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.bilson093.netdisk-cleaner",
    "productName": "NetdiskCleaner",
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "NetdiskCleaner-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
